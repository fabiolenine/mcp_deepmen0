# mem0-mcp-selfhosted environment variables
# Copy to .env and fill in values. Never commit .env with real secrets.

# --- LLM Provider ---
# MEM0_LLM_PROVIDER=anthropic          # anthropic | ollama
# MEM0_LLM_MODEL=claude-opus-4-6       # Model name (default depends on provider)
# MEM0_LLM_MAX_TOKENS=16384
# MEM0_LLM_URL=http://localhost:11434   # Ollama base URL (only for ollama provider)

# --- Anthropic Auth (pick one) ---
# MEM0_ANTHROPIC_TOKEN=               # OAuth/OAT token (highest priority)
# ANTHROPIC_API_KEY=                   # Standard API key (fallback)

# --- Embedder ---
# MEM0_EMBED_PROVIDER=ollama
# MEM0_EMBED_MODEL=bge-m3
# MEM0_EMBED_URL=http://localhost:11434
# MEM0_EMBED_DIMS=1024

# --- Vector Store (Qdrant) ---
# MEM0_QDRANT_URL=http://localhost:6333
# MEM0_COLLECTION=mem0_mcp_selfhosted
# MEM0_QDRANT_API_KEY=
# MEM0_QDRANT_ON_DISK=false

# --- Graph Store (Neo4j) ---
# MEM0_ENABLE_GRAPH=false
# MEM0_NEO4J_URL=bolt://127.0.0.1:7687
# MEM0_NEO4J_USER=neo4j
# MEM0_NEO4J_PASSWORD=mem0graph
# MEM0_NEO4J_DATABASE=
# MEM0_NEO4J_BASE_LABEL=
# MEM0_GRAPH_THRESHOLD=0.7

# --- Graph LLM ---
# MEM0_GRAPH_LLM_PROVIDER=anthropic    # anthropic | ollama | gemini | gemini_split
# MEM0_GRAPH_LLM_MODEL=                # Defaults to MEM0_LLM_MODEL
# MEM0_GRAPH_LLM_URL=                  # Defaults to MEM0_LLM_URL (ollama only)

# --- Gemini (for graph LLM) ---
# GOOGLE_API_KEY=

# --- Split-model Graph LLM (gemini_split) ---
# MEM0_GRAPH_CONTRADICTION_LLM_PROVIDER=anthropic
# MEM0_GRAPH_CONTRADICTION_LLM_MODEL=

# --- Server ---
# MEM0_HOST=0.0.0.0
# MEM0_PORT=8081
# MEM0_TRANSPORT=stdio                 # stdio | sse | streamable-http
# MEM0_LOG_LEVEL=INFO

# --- Memory Defaults ---
# MEM0_USER_ID=default
# MEM0_HISTORY_DB_PATH=

# --- Async ingest queue (v0.4) ---
# MEM0_ASYNC_INGEST=true               # false = synchronous add_memory (kill switch)
# MEM0_QUEUE_DB_PATH=                  # default: <history dir>/ingest_queue.db (~/.mem0/)
# MEM0_QUEUE_MAX_ATTEMPTS=4
# MEM0_QUEUE_BACKOFF_BASE=30           # seconds; exponential (30, 60, 120, ...)
# MEM0_QUEUE_POLL_INTERVAL=2
# MEM0_QUEUE_EST_ADD_S=180             # wait-estimate cost of one conversation add (p75 service time, reference host, jul/2026)
# MEM0_QUEUE_EST_UPDATE_S=200          # wait-estimate cost of one update (provisional, n=2)
# MEM0_QUEUE_WARMUP=true               # preload the Ollama model after idleness
# MEM0_QUEUE_GC_INTERVAL=3600
# MEM0_QUEUE_DONE_RETENTION=604800     # 7d; <=0 keeps done rows forever
# MEM0_QUEUE_DEAD_RETENTION=2592000    # 30d; dead rows are the inspect/requeue material

# --- Document ingestion (v0.5a — digital PDFs) ---
# MEM0_DOC_ENABLED=true                # kill switch for add_document
# MEM0_DOC_PATH_ALLOWLIST=             # ':'-separated path prefixes; default $HOME
# MEM0_DOC_SPOOL_DIR=                  # default ~/.mem0/ingest_spool
# MEM0_DOC_MAX_BYTES=26214400          # 25MB
# MEM0_DOC_MAX_PAGES=50                # rejects (never truncates) larger documents
# MEM0_DOC_CHUNK_CHARS=1800
# MEM0_DOC_CHUNK_OVERLAP=200
# MEM0_DOC_EXTRACT_TIMEOUT=120         # pdftotext timeout (seconds)
# MEM0_DOC_EST_CHUNK_S=120             # wait-estimate cost of one document chunk (conservative; OCR 75-135, digital ~120)
# MEM0_DOC_INTERLEAVE=true             # conversations jump the line between chunks
# MEM0_DOC_INTERLEAVE_MAX=2            # max conversations drained per chunk

# --- Vision / image ingestion (v0.5b — scanned PDFs + images) ---
# MEM0_ENABLE_VISION=false             # true = OCR scanned pages + ingest PNG/JPEG via a local VLM
# MEM0_VLM_MODEL=qwen3-vl:4b-instruct  # local Ollama VLM (use an -instruct variant; thinking models return empty)
# MEM0_VLM_URL=                        # defaults to MEM0_LLM_URL / MEM0_OLLAMA_URL / localhost:11434
# MEM0_VLM_TIMEOUT=300                 # per-page transcription timeout (seconds)
# MEM0_VLM_DPI=150                     # pdftoppm rasterization DPI for scanned pages
# MEM0_VLM_NUM_PREDICT=2048            # max transcription tokens per page
# MEM0_VLM_NUM_CTX=8192                # context window; a 150-DPI page is ~4k vision tokens, default 4096 overflows
# MEM0_VLM_KEEP_ALIVE=5m               # keep the VLM resident during a document's transcription phase

# --- Vault: bearer-token auth for this MCP (:8081 side) ---
# MEM0_REQUIRE_AUTH=off                # off | shadow | on. A typo raises at boot
#                                      # instead of silently serving unauthenticated.
# MEM0_VAULT_DB_PATH=                  # default ~/.mem0/vault.db; MUST match the
#                                      # vault service's path (shared SQLite file)

# --- Vault: the UI service (:8080 side, deepmem0-vault) ---
# Put these in .vault.env (mode 600, gitignored), never here.
# VAULT_SECRET_KEY=                    # REQUIRED: signs session cookies
# VAULT_HOST=0.0.0.0
# VAULT_PORT=8080
# VAULT_TOKEN_GRACE_HOURS=24           # how long a rotated token stays valid
# VAULT_MCP_HEALTH_URL=http://127.0.0.1:8081/health   # dashboard tile
# VAULT_LOG_LEVEL=info
# VAULT_ADMIN_EMAIL= / VAULT_ADMIN_PASSWORD= / VAULT_ADMIN_NAME=
#                                      # only read by `deepmem0-vault bootstrap-admin`;
#                                      # remove them from the env file afterwards

# --- Vault: the corpus screens (/memories, /search, /queue, /entities) ---
# These say WHICH corpus this install shows. The package ships neutral defaults
# on purpose — baking a concrete collection or user id into the code would make
# a fresh install point at someone else's data. The cost of leaving them unset
# is a screen that renders EMPTY without saying why, so set them next to the
# ones the MCP service already uses.
# VAULT_QDRANT_COLLECTION=             # defaults to MEM0_COLLECTION, then to the
#                                      # package default (mem0_mcp_selfhosted).
#                                      # MUST match the MCP's MEM0_COLLECTION,
#                                      # including after a collection cutover
# VAULT_MEMORY_USER_ID=                # scope shown in the UI; defaults to
#                                      # MEM0_USER_ID. The UI must not look at a
#                                      # different scope than clients write to
# VAULT_MEMORY_AGENT_ID= / VAULT_MEMORY_RUN_ID=   # optional narrower scope
# VAULT_QDRANT_URL=http://127.0.0.1:6333
# MEM0_QDRANT_API_KEY=                 # comes from .qdrant.env via a systemd
#                                      # drop-in; without it the corpus screens
#                                      # show an error card and the credential
#                                      # screens keep working
# VAULT_MCP_URL=http://127.0.0.1:18081/mcp   # the MCP ITSELF, not the reverse
#                                      # proxy — semantic search goes through the
#                                      # production pipeline, always reinforce=false
# VAULT_MCP_TOKEN=                     # issue one with
#                                      # `deepmem0-vault issue-token --label vault-ui`
#                                      # so the UI is an auditable client like any other
# VAULT_INGEST_DB= / VAULT_HISTORY_DB= # default ~/.mem0/{ingest_queue,history}.db,
#                                      # opened read-only (mode=ro + query_only)
# VAULT_OBSERVE_URL=                   # optional link to the metrics dashboards

# --- Vault atrás de proxy reverso (TLS) ---
# VAULT_HTTPS_ONLY=false               # true = cookie Secure + nome rotacionado
#                                      # (sessões emitidas em http morrem no cutover).
#                                      # Parser ESTRITO: typo levanta, não vira false.
# VAULT_FORWARDED_ALLOW_IPS=127.0.0.1  # de quem aceitar X-Forwarded-For
# MEM0_FORWARDED_ALLOW_IPS=127.0.0.1   # idem, no :8081

# --- Contrato de messages na fronteira de escrita ---
# Recusa, no submit do add_memory, o payload que evaporaria em silêncio: o core
# roda com enable_vision=False e DESCARTA partes image_url — se a mensagem só
# tinha imagem, ela some inteira e o cliente recebe "queued" assim mesmo.
# Para ingerir imagem use add_document(file_path=...), que transcreve no VLM local.
#
#                     enforce   warn                 off
#   texto + imagem    recusa    aceita + loga        aceita mudo
#   IMAGEM-SÓ         recusa    RECUSA               aceita mudo
#
# Imagem-só é recusada em enforce E em warn: o core descarta a mensagem inteira,
# o job produz zero fato, e devolver "queued" ali é mentira verificável.
# Em `off`, NÃO — `off` é o KILL SWITCH e restaura o comportamento pré-contrato
# por inteiro, a perda silenciosa inclusive. Rollback parcial é pior que nenhum:
# quem põe `off` num incidente espera o estado anterior, não um subconjunto.
# Nasce em `warn` de propósito — hoje texto+imagem conserva o texto, e estrear em
# `enforce` viraria erro duro sem auditar chamadores. Promoção só com evidência
# medida (contador `pass` na telemetria + zero `warn_mixed` na janela).
# Valor inválido DERRUBA O BOOT, não a primeira escrita.
MEM0_MESSAGE_CONTRACT=warn
